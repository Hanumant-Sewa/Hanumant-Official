# ===========================================
# Hanumant Seva — Backend (.env example)
# Copy to `.env`:  cp .env.example .env
# ===========================================

# --- Server ---
PORT=5000
NODE_ENV=development
# Set to "production" on deploy (enables `secure: true` cookies in authController.js)

# --- Frontend / CORS ---
# Set these to your deployed frontend URL in production
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL + Prisma 7 + @prisma/adapter-pg) ---
# Used in: src/config/prisma.js, prisma.config.ts
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hanumant_seva?schema=public"

# --- Auth (JWT cookie, 7d expiry in src/controllers/authController.js) ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# --- Admin login ---
# Required for loginType="admin" in src/controllers/authController.js
# Must match the `adminKey` sent from the frontend Admin login
ADMIN_SECURITY_KEY=change-me-to-a-strong-admin-key

# --- Initial admin seed ---
# Used only by `npm run db:seed-admin`. Keep these values out of Git.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-unique-password-with-at-least-16-characters

# --- Payments (Razorpay) ---
# Use Razorpay test keys for local development.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
