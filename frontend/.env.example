# ===========================================
# Hanumant Seva — Frontend (.env example)
# Copy to `.env`:  cp .env.example .env
# Vite only exposes vars prefixed with VITE_
# ===========================================

# Backend API base URL
# Local dev default: http://localhost:5000
# Production example: https://your-api.onrender.com
VITE_API_URL=http://localhost:5000

# Frontend dev server port (optional, Vite default is 5173)
# Must match Backend CORS origin (FRONTEND_URL / CORS_ORIGIN)
VITE_PORT=5173
